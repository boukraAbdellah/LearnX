# ─── Sanity ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
# Default: use current date (YYYY-MM-DD). Omit to use the value from sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=

# Viewer token — create at sanity.io/manage > API > Tokens > Add API token (Viewer role)
# Server-only: never prefix with NEXT_PUBLIC_
SANITY_API_READ_TOKEN=

# Write token — create at sanity.io/manage > API > Tokens > Add API token (Editor role)
# Used to record learner progress. Server-only.
SANITY_API_WRITE_TOKEN=


# ─── Clerk ────────────────────────────────────────────────────────────────────
# Get these from your Clerk dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
